{
  "name": "jot",
  "productName": "Jot",
  "version": "1.6.4",
  "description": "A draggable, always-on-top todo & notes widget",
  "main": "main.js",
  "author": "rushanwi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rwbuilds/To-Do-App"
  },
  "scripts": {
    "start": "electron .",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "version:check": "node scripts/check-version-sync.js",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "update-electron-app": "^3.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.4.0",
    "@electron-forge/maker-dmg": "^7.4.0",
    "@electron-forge/maker-squirrel": "^7.4.0",
    "@electron-forge/maker-zip": "^7.4.0",
    "electron": "^44.7.0"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "Jot",
        "executableName": "jot",
        "icon": "icon",
        "asar": true,
        "osxSign": {
          "identity": "-"
        }
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "platforms": [
            "win32"
          ],
          "config": {
            "name": "jot",
            "setupExe": "JotSetup.exe",
            "setupIcon": "icon.ico"
          }
        },
        {
          "name": "@electron-forge/maker-dmg",
          "platforms": [
            "darwin"
          ],
          "config": {
            "name": "Jot",
            "icon": "icon.icns"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "win32",
            "darwin"
          ]
        }
      ]
    }
  }
}
